# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Jev (TypeSafe AI) for the AI panel verdicts
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Optional: 1 = the AI panel also reads each paper's introduction and conclusion
# (arXiv HTML or open-access PDF). ~5x the Jev tokens per paper.
FULL_TEXT=
# Optional: any endpoint that speaks the /v1/systemone format
# JEV_BASE_URL=https://api.typesafe.ai

# Optional: one-line takes (Jev can't write text)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Protects /api/cron and /api/judge. Any long random string.
CRON_SECRET=
CRON_MAX_PAPERS=15

# OpenAlex (optional): email for the polite pool, key if OpenAlex requires one
OPENALEX_MAILTO=you@example.com
OPENALEX_API_KEY=
